MEDIA_PROVIDER_API_KEY=your_provider_api_key
MEDIA_PROVIDER_READ_TOKEN=your_provider_read_token
TMDB_API_KEY=your_tmdb_api_key
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token
API_TIMEOUT_MS=7000
API_RATE_LIMIT_TOKENS_PER_SEC=30
API_RATE_LIMIT_BURST=45
API_RATE_LIMIT_SCOPE_WEIGHTS={"search":1,"media-details":1,"media-seasons":1,"media-episodes":2,"refresh":2}
# Legacy fixed-window fallback only:
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=60
APP_ID=your_app_id
FIREBASE_SERVICE_ACCOUNT_PATH=./hearthv2-firebase-adminsdk-fbsvc-88544fef3e.json

# Optional server-only classification pilot. Never use a VITE_ prefix.
# These settings may also live in ignored .env.local (loaded first).
# GEMINI_API is also accepted, but GEMINI_API_KEY is preferred.
GEMINI_API_KEY=
# Select an available free-tier structured-output model in AI Studio.
GEMINI_MODEL=
GEMINI_CLASSIFICATION_ENABLED=false
# Set only after reviewing permission to share TMDB-derived public metadata.
GEMINI_METADATA_SHARING_APPROVED=false
GEMINI_DAILY_REQUEST_LIMIT=20
GEMINI_TIMEOUT_MS=5000
