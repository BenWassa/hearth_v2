  "narrative": {
    "northStar": "The Lamp-Lit Living Room",
    "overview": "Hearth is a dark, warm room with one source of light. The shell is a near-black with a trace of brown, and everything else is lit from within: poster and backdrop artwork supplies the drama, and a single amber accent plays the role of the lamp. The interface chrome stays low and quiet so two people on a couch can look at titles, not at controls.",
    "keyCharacteristics": [
      "Near-black warm shell; amber as the only brand accent.",
      "Serif titles over a system sans body; tiny uppercase tracked labels for metadata.",
      "Soft, large radii (12px controls, 16px to 24px containers, full pills for chips).",
      "Artwork-first: posters and backdrops are the saturated element, chrome recedes.",
      "Tonal depth first, shadow second; blur only where text must sit on artwork.",
      "Dim-room comfort: no pure black, no pure white, no glare."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "Amber is the only brand hue. On any screen it marks the primary action and the current state, nothing else.",
        "section": "colors"
      },
      {
        "name": "The Warm Neutral Rule",
        "body": "Every grey is a stone (warm-tinted). Pure #000 and #fff are forbidden.",
        "section": "colors"
      },
      {
        "name": "The Energy Code Rule",
        "body": "Sky, amber and red appear together only as the light / balanced / focused energy indicator, always with a text label.",
        "section": "colors"
      },
      {
        "name": "The Serif Names Things Rule",
        "body": "Serif is for things with names. Sans is for things that describe or act.",
        "section": "typography"
      },
      {
        "name": "The Small Caps Eyebrow Rule",
        "body": "Eyebrows are 10px to 11px, bold, uppercase, widely tracked, and never carry primary information.",
        "section": "typography"
      },
      {
        "name": "The Dim Room Rule",
        "body": "Surfaces are flat at rest; lift and glow answer state or float above artwork.",
        "section": "elevation"
      },
      {
        "name": "The Functional Blur Rule",
        "body": "Backdrop blur is a legibility device over imagery, never decoration.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do let poster and backdrop artwork be the saturated element; keep chrome in stone neutrals.",
      "Do use Ember Amber (#d97706) for exactly one primary action per surface, with Soot (#1c1917) text.",
      "Do tint every neutral warm (the stone ramp); end at Bone (#f5f5f4) and Shell Black (#0c0a09).",
      "Do pair every color-coded state (energy, watched, in progress) with a label or icon.",
      "Do paint the shell Shell Black behind notches and overscroll, and add --safe-* insets to fixed bars.",
      "Do honor prefers-reduced-motion on any new animation, and animate transform and opacity only."
    ],
    "donts": [
      "Don't build a gamified or social app: no streaks, badges, feeds, leaderboards or notification nags.",
      "Don't drift into a generic dark SaaS dashboard: no cold blue-grey panels, glass cards, gradient accents or gradient text.",
      "Don't show algorithmic recommender patterns: no match percentages, no \"because you watched\", no ranked or explained suggestions.",
      "Don't use blur or translucency on plain backgrounds; it is only for legibility over artwork.",
      "Don't use #000 or #fff, or introduce a second brand hue beside amber.",
      "Don't add border-left or border-right wider than 1px as a colored accent.",
      "Don't create endless rows, autoplay or infinite scroll; the shelf is finite on purpose."
    ]
  }
}
